# Sao chép thành .env rồi sửa giá trị
WG_HOST=vpn.ten-mien-ddns-cua-ban.net
# Tạo hash bằng lệnh:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'mat-khau-cua-ban'
# Dán nguyên chuỗi $2a$12$... vào giữa 2 dấu nháy đơn
PASSWORD_HASH='$2a$12$thay-bang-hash-that'
# IP Pi-hole trong LAN; nếu chưa có Pi-hole thì dùng 1.1.1.1
WG_DNS=192.168.0.2
